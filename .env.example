# ==============================================================================
# The Big Bro's NetSec Armoury - Environment Variables
# Copy this file to .env.local for local development. Never commit real secrets.
# ==============================================================================

# Vercel Postgres Connection (Required for persistence)
# Automatically populated when linking a Vercel Postgres storage store:
POSTGRES_URL="postgres://default:password@ep-cool-sample.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
POSTGRES_PRISMA_URL="postgres://default:password@ep-cool-sample.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require&pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://default:password@ep-cool-sample.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
POSTGRES_USER="default"
POSTGRES_HOST="ep-cool-sample.us-east-1.postgres.vercel-storage.com"
POSTGRES_PASSWORD="your-postgres-password"
POSTGRES_DATABASE="verceldb"
# NextAuth / Auth.js (Phase 2 Shared Systems)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-random-secret-e.g.-openssl-rand-hex-32"

# Google OAuth Credentials (Phase 2 Shared Systems)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Cron Job Secret (Phase 19 History Purge)
CRON_SECRET="GeneratedKeyHere"


# Google Gemini API Key (Phase 20 - AI Zone)
GEMINI_API_KEY="AIzaSyYourGeneratedKeyHere"

